# Environment Configuration
ENVIRONMENT=development
PROJECT_NAME="AI Code Reviewer"
VERSION=1.0.0
API_V1_STR=/api/v1

# Security & JWT
SECRET_KEY=super-secret-key-change-in-production-min-32-chars-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# For Local Development (Zero setup SQLite async):
DATABASE_URL=sqlite+aiosqlite:///./aicode_reviewer.db

# For Production / Docker PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/aicode_reviewer

# CORS Allowed Origins (comma-separated or JSON list)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://localhost:80

# AI Review Engine Provider Selection ("openai", "gemini", or "mock")
AI_PROVIDER=openai

# OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# Google Gemini Configuration
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash

# GitHub Pull Request Integration (Optional for public PRs, recommended for rate limits / private repos)
GITHUB_TOKEN=your-github-personal-access-token-here

# Limits and Data Retention Policy
MAX_CODE_SIZE_BYTES=100000
MAX_DIFF_SIZE_BYTES=250000
STORE_SOURCE_CODE=true
